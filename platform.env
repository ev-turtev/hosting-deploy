# Платформата — попълва се ВЕДНЪЖ. Чете се от всички скриптове, затова в
# Cloud Shell не се въвеждат ID-та на ръка.

# Subscription ID на platform-shared (празно = subscription-ът с име platform-shared)
PLATFORM_SUB=00e26e91-fff0-4392-b9d1-2a038d3fc74d

# Регионът на всичко (клиентите — в същия)
LOCATION=westeurope

# НАШЕТО GitHub repo с workflow-ите за деплой (<org>/<repo>, private), напр.
# eveliko/hosting-deploy. Там живеят deploy-<клиент>-<приложение>.yml, които
# теглят кода от repo-то на клиента с read-only token — без права в него.
# Празно = workflow-ите са в repo-то на клиента (когато клиентът ги поеме).
DEPLOY_REPO=ev-turtev/hosting-deploy
