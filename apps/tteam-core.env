# tteam / core — tteam-core (счетоводното ядро).
# Името на файла е <клиент>-<приложение>.env. Чете го deploy-app.sh (и
# действията new-client / add-app / add-staging).

# GitHub repo-то с кода (<org>/<repo>). Празно = GitHub още не е свързан.
REPO=

# Dockerfile-ът спрямо корена на repo-то
DOCKERFILE=deploy/Dockerfile

# Bicep параметрите на приложението (app/main.bicep):
#   порт и health — apps/api (Fastify на 8080, GET /api/health);
#   миграциите — node dist/migrate.js (deploy/Dockerfile);
#   citext — 0001_core.sql;
#   ролите — ВГРАДЕНИ в миграциите на tteam-core (0002 и сл.), затова не са
#   per база. Втора tteam-core база на същия сървър (staging!) чака промяната
#   в приложението — dbinit я отказва (README, "Известни ограничения").
APP_PARAMS='targetPort=8080 healthPath=/api/health migrateCommand=["node","dist/migrate.js"] dbExtensions=["citext"] appDbUser=tteam_app appMigratorUser=tteam_admin'
